---
interface LinkItem { href: string; label: string; }
interface Props { links: LinkItem[]; }
const { links } = Astro.props;
---
<nav class="related" aria-label="Further reading">
  <h2>Further Reading</h2>
  <ul>
    {links.map((link) => (
      <li><a href={link.href} class="related-link">{link.label}</a></li>
    ))}
  </ul>
</nav>
