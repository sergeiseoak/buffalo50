---
interface Props {
  size?: 'large' | 'medium';
}
const { size = 'large' } = Astro.props;
---
<div class={`badge ${size}`}>
  <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="badgeSky" cx="50%" cy="30%" r="75%">
        <stop offset="0%" stop-color="#FFFCF2"/>
        <stop offset="60%" stop-color="#F3ECDA"/>
        <stop offset="100%" stop-color="#DCCFA8"/>
      </radialGradient>
      <radialGradient id="sunGlow" cx="50%" cy="45%" r="60%">
        <stop offset="0%" stop-color="#FFF6DC"/>
        <stop offset="55%" stop-color="#EFCB74"/>
        <stop offset="100%" stop-color="#B4892C"/>
      </radialGradient>
      <linearGradient id="mtnFar" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3E6249"/>
        <stop offset="100%" stop-color="#294C36"/>
      </linearGradient>
      <linearGradient id="mtnNear" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2C4A34"/>
        <stop offset="100%" stop-color="#14261A"/>
      </linearGradient>
      <linearGradient id="buffaloBody" x1="0.2" y1="0" x2="0.8" y2="1">
        <stop offset="0%" stop-color="#9C3B48"/>
        <stop offset="55%" stop-color="#7A2430"/>
        <stop offset="100%" stop-color="#4E141D"/>
      </linearGradient>
      <linearGradient id="ribbonFace" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#8E2C39"/>
        <stop offset="100%" stop-color="#6B1E29"/>
      </linearGradient>
      <linearGradient id="ribbonFold" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#5E1A24"/>
        <stop offset="100%" stop-color="#3E0F16"/>
      </linearGradient>
      <linearGradient id="coinFace" x1="0.2" y1="0" x2="0.8" y2="1">
        <stop offset="0%" stop-color="#F0DFA0"/>
        <stop offset="45%" stop-color="#D9B45C"/>
        <stop offset="100%" stop-color="#96721E"/>
      </linearGradient>
      <filter id="softShadow" x="-40%" y="-40%" width="180%" height="180%">
        <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#1E1408" flood-opacity="0.35"/>
      </filter>
      <clipPath id="badgeClip"><circle cx="200" cy="200" r="188"/></clipPath>
    </defs>

    <!-- outer rim: layered rings for a struck-medal look -->
    <circle cx="200" cy="200" r="198" fill="#8C6A1E"/>
    <circle cx="200" cy="200" r="193" fill="#DCB65C"/>
    <circle cx="200" cy="200" r="188" fill="url(#badgeSky)" stroke="#2C4A34" stroke-width="5"/>
    <circle cx="200" cy="200" r="176" fill="none" stroke="#B4892C" stroke-width="2"/>
    <circle cx="200" cy="200" r="168" fill="none" stroke="#B4892C" stroke-width="1" stroke-dasharray="2 6" opacity="0.8"/>

    <g clip-path="url(#badgeClip)">
      <!-- sun with glow -->
      <circle cx="200" cy="118" r="66" fill="#F3ECDA" opacity="0.35"/>
      <circle cx="200" cy="118" r="36" fill="url(#sunGlow)"/>
      <circle cx="200" cy="118" r="36" fill="none" stroke="#8C6A1E" stroke-width="1" opacity="0.4"/>

      <!-- distant mountain range -->
      <path d="M-10 245 L60 165 L110 210 L165 130 L230 220 L295 150 L410 250 Z" fill="url(#mtnFar)" filter="url(#softShadow)"/>
      <!-- snow caps -->
      <path d="M165 130 L152 158 L178 158 Z" fill="#EDE6CC" opacity="0.85"/>
      <path d="M295 150 L284 172 L306 172 Z" fill="#EDE6CC" opacity="0.75"/>

      <!-- near mountain / hill mass with hatching for texture -->
      <path d="M-10 270 L70 195 L135 245 L200 175 L270 250 L340 190 L410 270 L410 340 L-10 340 Z" fill="url(#mtnNear)"/>
      <g stroke="#0E1D13" stroke-width="1" opacity="0.35">
        <path d="M40 260 L90 220"/>
        <path d="M60 275 L115 230"/>
        <path d="M230 250 L270 215"/>
        <path d="M255 262 L292 228"/>
      </g>

      <!-- pines -->
      <g fill="#14261A">
        <path d="M52 335 L64 300 L76 335 Z"/>
        <path d="M52 322 L64 292 L76 322 Z"/>
        <path d="M330 335 L342 300 L354 335 Z"/>
        <path d="M330 322 L342 292 L354 322 Z"/>
      </g>

      <!-- foreground ground band -->
      <rect x="-10" y="330" width="420" height="30" fill="#B5541F" opacity="0.22"/>

      <!-- eagle silhouette with shading -->
      <g transform="translate(302,124)" filter="url(#softShadow)">
        <path d="M0 0 C-16 -7 -30 -2 -34 7 C-24 6 -17 11 -15 18 C-8 11 3 11 7 18 C11 11 22 6 31 9 C24 0 13 -7 0 0 Z" fill="#8C3E14"/>
        <path d="M0 0 C-8 -3 -15 -1 -18 3" stroke="#5A2409" stroke-width="1.4" fill="none" opacity="0.6"/>
        <circle cx="2" cy="4" r="3.2" fill="#2C4A34"/>
      </g>

      <!-- wolf silhouette -->
      <g transform="translate(90,148)" filter="url(#softShadow)">
        <path d="M0 22 C-5 6 4 -7 18 -5 C20 -12 29 -14 33 -7 C44 -9 51 0 46 9 C53 13 51 22 42 22 Z" fill="#1E3324"/>
        <circle cx="14" cy="4" r="1.8" fill="#F3ECDA"/>
      </g>

      <!-- buffalo, the medallion's centerpiece -->
      <g transform="translate(200,272)" filter="url(#softShadow)">
        <path d="M-98 20 C-93 -6 -76 -20 -60 -15 C-58 -35 -38 -50 -18 -43 C-12 -58 10 -60 16 -45 C39 -54 62 -37 53 -15 C85 -15 102 9 87 28 C102 37 96 52 78 52 L-76 52 C-98 52 -104 34 -98 20 Z" fill="url(#buffaloBody)"/>
        <!-- shading pass to suggest musculature -->
        <path d="M-40 -30 C-30 -20 -20 -5 -20 15" stroke="#3A0C13" stroke-width="6" opacity="0.35" fill="none" stroke-linecap="round"/>
        <path d="M20 -20 C30 -8 34 8 30 24" stroke="#3A0C13" stroke-width="5" opacity="0.3" fill="none" stroke-linecap="round"/>
        <!-- highlight -->
        <path d="M-70 -8 C-62 -20 -48 -26 -36 -24" stroke="#C97D66" stroke-width="4" opacity="0.4" fill="none" stroke-linecap="round"/>
        <circle cx="-58" cy="6" r="4.4" fill="#1E100A"/>
        <circle cx="-59.5" cy="4.5" r="1.3" fill="#F3ECDA" opacity="0.8"/>
        <path d="M-72 -19 C-79 -30 -76 -42 -64 -44" stroke="#14261A" stroke-width="4.5" fill="none" stroke-linecap="round"/>
        <path d="M-52 -21 C-45 -32 -47 -44 -59 -46" stroke="#14261A" stroke-width="4.5" fill="none" stroke-linecap="round"/>
      </g>
    </g>

    <!-- ribbon banner, layered for a folded-cloth look -->
    <path d="M56 208 L344 208 L320 232 L344 256 L56 256 L80 232 Z" fill="url(#ribbonFace)" filter="url(#softShadow)"/>
    <path d="M56 208 L80 232 L56 256 Z" fill="url(#ribbonFold)"/>
    <path d="M344 208 L320 232 L344 256 Z" fill="url(#ribbonFold)"/>
    <path d="M60 212 L340 212" stroke="#B87D8A" stroke-width="1.5" opacity="0.5"/>
    <text x="200" y="240" font-family="Georgia, serif" font-size="29" font-weight="700" fill="#F3ECDA" text-anchor="middle" letter-spacing="1" style="paint-order: stroke; stroke: #3E0F16; stroke-width: 0.6px;">BUFFALO 50</text>

    <!-- paylines coin badge -->
    <circle cx="200" cy="292" r="27" fill="url(#coinFace)" stroke="#7A5B1A" stroke-width="1.5" filter="url(#softShadow)"/>
    <circle cx="200" cy="292" r="22" fill="none" stroke="#7A5B1A" stroke-width="1" opacity="0.6"/>
    <text x="200" y="286" font-family="Georgia, serif" font-size="9" fill="#3B2A0A" text-anchor="middle" font-weight="700">50</text>
    <text x="200" y="299" font-family="Georgia, serif" font-size="7.5" fill="#3B2A0A" text-anchor="middle">LINES</text>
  </svg>
</div>

<style>
  .badge { width: 100%; max-width: 380px; margin: 0 auto; }
  .badge.medium { max-width: 240px; }
  .badge svg { width: 100%; height: auto; filter: drop-shadow(0 16px 30px rgba(43,32,21,0.35)); }
</style>
