---
import CTAButton from './CTAButton.astro';
interface Props {
  title: string;
  subtitle?: string;
  buttonLabel?: string;
  dataCta: string;
}
const { title, subtitle, buttonLabel = 'View the Game', dataCta } = Astro.props;
---
<div class="promo-badge">
  <div>
    <p class="promo-badge-title">{title}</p>
    {subtitle && <p class="promo-badge-sub">{subtitle}</p>}
  </div>
  <CTAButton label={buttonLabel} dataCta={dataCta} />
</div>
