---
import BaseLayout from '../layouts/BaseLayout.astro';
import WildlifeBadge from '../components/WildlifeBadge.astro';
import SpecCard from '../components/SpecCard.astro';
import PromoBanner from '../components/PromoBanner.astro';
import Ornament from '../components/Ornament.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTAButton from '../components/CTAButton.astro';
import FaqSection from '../components/FaqSection.astro';
import { buildFaqSchema } from '../lib/faqSchema';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'index');
if (!page) throw new Error('Missing src/content/pages/index.md');
const { Content } = await page.render();
const faqSchema = buildFaqSchema(page.data.faqItems);
---
<BaseLayout title={page.data.metaTitle} description={page.data.metaDescription} path="/" structuredData={faqSchema}>
  <section class="hero-section">
    <div class="wrap hero-grid">
      <div>
        <h1>{page.data.h1}</h1>
        <p class="lead">An independent field guide to Endorphina's 50-payline wildlife slot — RTP, symbols, Free Games and how the reels actually work.</p>
        <div class="hero-actions">
          <CTAButton label="Play Buffalo 50" dataCta="hero" size="lg" />
          <a href="/free-play/" class="btn-outline">Try Free Play</a>
        </div>
      </div>
      <WildlifeBadge />
    </div>
  </section>

  <section class="section">
    <div class="article-wrap">
      {page.data.specs && <SpecCard rows={page.data.specs} />}

      <div class="prose">
        <Content />
      </div>

      <Ornament />

      <PromoBanner
        title="Ready to see Buffalo 50 in action?"
        subtitle="Check the current game library at the casino."
        dataCta="article-bottom"
        buttonLabel="Play Buffalo 50"
      />

      <FaqSection items={page.data.faqItems} />

      <RelatedLinks links={[
        { href: '/free-play/', label: 'Buffalo 50 Free Play' },
        { href: '/how-to-play/', label: 'How to Play Buffalo 50' },
      ]} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section { background: var(--paper-alt); padding: 56px 0 60px; border-bottom: 3px solid var(--gold); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 44px; align-items: center; }
  .hero-grid h1 { margin-bottom: 14px; }
  .lead { font-size: 1.08rem; max-width: 46ch; }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 22px; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; text-align: center; } .hero-actions { justify-content: center; } .lead { margin-left: auto; margin-right: auto; } }
</style>
