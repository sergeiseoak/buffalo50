---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecCard from '../../components/SpecCard.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import Ornament from '../../components/Ornament.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import FaqSection from '../../components/FaqSection.astro';
import { buildFaqSchema } from '../../lib/faqSchema';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'free-play');
if (!page) throw new Error('Missing src/content/pages/free-play.md');
const { Content } = await page.render();
const faqSchema = buildFaqSchema(page.data.faqItems);
---
<BaseLayout title={page.data.metaTitle} description={page.data.metaDescription} path="/free-play/" structuredData={faqSchema}>
  <section class="section">
    <div class="article-wrap">
      <h1>{page.data.h1}</h1>

      {page.data.specs && <SpecCard title="Demo Snapshot" rows={page.data.specs} />}

      <PromoBanner
        title="Prefer real-money play right away?"
        subtitle="Buffalo 50 is available in the casino's game library."
        dataCta="free-play-top"
        buttonLabel="Play for Real"
      />

      <div class="prose">
        <Content />
      </div>

      <Ornament />

      <PromoBanner
        title="Ready to move past the demo?"
        subtitle="Open Buffalo 50 at the casino."
        dataCta="free-play-bottom"
        buttonLabel="Play Buffalo 50"
      />

      <FaqSection items={page.data.faqItems} />

      <RelatedLinks links={[
        { href: '/', label: '← Buffalo 50 Slot Guide' },
        { href: '/how-to-play/', label: 'How to Play Buffalo 50' },
      ]} />
    </div>
  </section>
</BaseLayout>
